PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/daypilot-ai
JWT_SECRET=your-secret-jwt-key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Gnani AI (Vachana) Speech-to-Text & Text-to-Speech API
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_token_here
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_USE_MOCK=false

# LLM Configuration (local, openai, gemini, groq)
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
